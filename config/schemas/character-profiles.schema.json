{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bibi-image-studio.local/schemas/character-profiles.schema.json",
  "title": "Bibi Character Profiles",
  "type": "object",
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "reference_images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identity_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "default_style_profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
